# Copy this file to .env, then fill in real values.
# NEVER commit the real .env file.
#
# PowerShell:
#   Copy-Item .env.example .env


PORT=8124


# JWT signing secret.
# MUST be at least 32 random characters.
#
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-32-plus-character-random-string


# JWT expiry
JWT_EXPIRES_IN=2h


# development | production | test
NODE_ENV=development


# SQLite database path.
# Use :memory: for tests.
DB_PATH=data/propcare.db


# Local/demo account password.
# Do not use a real production password here.
DEMO_PASSWORD=change-this-demo-password


# Optional comma-separated browser origins.
#
# Example:
# CORS_ORIGINS=http://localhost:8124,https://example.com
CORS_ORIGINS=